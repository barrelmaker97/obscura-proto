{
  "version": 1,
  "kind": "routing",
  "description": "L3 delivery-targeting conformance vectors. Given a model's schema config and an entry, pins the exact set of recipients an entry MUST reach (self always included), or the fail-loud error a kit MUST raise. Expectations are expressed at the recipient-identity (userId) level, NOT device level: audience -> who is the behavior that differs between kits; expanding a recipient to their devices is mechanical and out of scope. Every kit (Kotlin, Swift, web) runs this same file.",
  "topology": {
    "selfUserId": "uMe",
    "friends": [
      { "userId": "uA", "username": "alice", "status": "accepted" },
      { "userId": "uB", "username": "bob", "status": "accepted" },
      { "userId": "uC", "username": "carol", "status": "accepted" }
    ]
  },
  "cases": [
    {
      "name": "conversation audience delivers to both participants and self, no other friends",
      "schema": {
        "model": "directMessage",
        "sync": "gset",
        "audience": { "kind": "conversation", "field": "conversationId" }
      },
      "entry": {
        "id": "e-conv-ok",
        "data": { "conversationId": "uB_uMe", "content": "secret", "senderUsername": "me" }
      },
      "expect": { "recipients": ["uMe", "uB"] }
    },
    {
      "name": "recipient audience delivers to the single named recipient and self",
      "schema": {
        "model": "pix",
        "sync": "lww",
        "audience": { "kind": "recipient", "field": "recipientUsername" }
      },
      "entry": {
        "id": "e-recip-ok",
        "data": { "recipientUsername": "alice", "senderUsername": "me", "mediaRef": "ref-1" }
      },
      "expect": { "recipients": ["uMe", "uA"] }
    },
    {
      "name": "default audience (omitted) broadcasts to all friends and self",
      "schema": { "model": "story", "sync": "gset", "ttl": "24h" },
      "entry": { "id": "e-story", "data": { "content": "hi all", "authorUsername": "me" } },
      "expect": { "recipients": ["uMe", "uA", "uB", "uC"] }
    },
    {
      "name": "explicit friends audience broadcasts to all friends and self",
      "schema": {
        "model": "profile",
        "sync": "lww",
        "audience": { "kind": "friends" }
      },
      "entry": { "id": "e-profile", "data": { "displayName": "Me", "bio": "hi" } },
      "expect": { "recipients": ["uMe", "uA", "uB", "uC"] }
    },
    {
      "name": "self audience never leaves own devices",
      "schema": {
        "model": "settings",
        "sync": "lww",
        "audience": { "kind": "self" }
      },
      "entry": { "id": "e-settings", "data": { "theme": "dark", "notificationsEnabled": true } },
      "expect": { "recipients": ["uMe"] }
    },
    {
      "name": "recipient audience naming a non-friend fails safe to self only (never broadcasts)",
      "schema": {
        "model": "pix",
        "sync": "lww",
        "audience": { "kind": "recipient", "field": "recipientUsername" }
      },
      "entry": {
        "id": "e-recip-stranger",
        "data": { "recipientUsername": "stranger", "senderUsername": "me", "mediaRef": "ref-2" }
      },
      "expect": { "recipients": ["uMe"] }
    },
    {
      "name": "LEAK GUARD: conversation with a malformed 3-party id must fail loud, never broadcast",
      "schema": {
        "model": "directMessage",
        "sync": "gset",
        "audience": { "kind": "conversation", "field": "conversationId" }
      },
      "entry": {
        "id": "e-conv-3party",
        "data": { "conversationId": "uMe_uB_uC", "content": "x", "senderUsername": "me" }
      },
      "expect": { "error": "DIRECT_ROUTING_UNRESOLVED" }
    },
    {
      "name": "conversation audience with a missing id field must fail loud",
      "schema": {
        "model": "directMessage",
        "sync": "gset",
        "audience": { "kind": "conversation", "field": "conversationId" }
      },
      "entry": {
        "id": "e-conv-missing",
        "data": { "content": "x", "senderUsername": "me" }
      },
      "expect": { "error": "DIRECT_ROUTING_UNRESOLVED" }
    },
    {
      "name": "recipient audience with a missing recipient field must fail loud",
      "schema": {
        "model": "pix",
        "sync": "lww",
        "audience": { "kind": "recipient", "field": "recipientUsername" }
      },
      "entry": {
        "id": "e-recip-missing",
        "data": { "senderUsername": "me", "mediaRef": "ref-3" }
      },
      "expect": { "error": "DIRECT_ROUTING_UNRESOLVED" }
    },
    {
      "name": "recipient audience with a blank recipient field must fail loud",
      "schema": {
        "model": "pix",
        "sync": "lww",
        "audience": { "kind": "recipient", "field": "recipientUsername" }
      },
      "entry": {
        "id": "e-recip-blank",
        "data": { "recipientUsername": "", "senderUsername": "me", "mediaRef": "ref-4" }
      },
      "expect": { "error": "DIRECT_ROUTING_UNRESOLVED" }
    }
  ]
}
