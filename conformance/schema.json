{
  "version": 1,
  "kind": "schema",
  "description": "L3 model-config parsing conformance. Given one model's raw config (the value in the shared schema.ts map), pins how a kit MUST parse it into an internal model config — field types (base + optional), sync strategy, ttl, and audience — or the fail-loud error a kit MUST raise for an invalid definition. This is what prevents divergent parsing (the class of bug where one kit silently ignored `audience` and a private model broadcast to all friends). Every kit runs the same file.",
  "cases": [
    {
      "name": "directMessage: gset + conversation audience, all string fields",
      "config": {
        "fields": { "conversationId": "string", "content": "string", "senderUsername": "string" },
        "sync": "gset",
        "audience": { "kind": "conversation", "field": "conversationId" }
      },
      "expect": {
        "sync": "gset",
        "ttl": null,
        "audience": { "kind": "conversation", "field": "conversationId" },
        "fields": {
          "conversationId": { "type": "string", "optional": false },
          "content": { "type": "string", "optional": false },
          "senderUsername": { "type": "string", "optional": false }
        }
      }
    },
    {
      "name": "story: gset + ttl 24h + optional string fields, audience defaults to friends",
      "config": {
        "fields": { "content": "string", "authorUsername": "string", "mediaRef": "string?", "captionMeta": "string?" },
        "sync": "gset",
        "ttl": "24h"
      },
      "expect": {
        "sync": "gset",
        "ttl": "24h",
        "audience": { "kind": "friends", "field": null },
        "fields": {
          "content": { "type": "string", "optional": false },
          "authorUsername": { "type": "string", "optional": false },
          "mediaRef": { "type": "string", "optional": true },
          "captionMeta": { "type": "string", "optional": true }
        }
      }
    },
    {
      "name": "profile: lww, no audience key -> friends default, mixed optional",
      "config": {
        "fields": { "displayName": "string", "bio": "string?", "avatarUrl": "string?" },
        "sync": "lww"
      },
      "expect": {
        "sync": "lww",
        "ttl": null,
        "audience": { "kind": "friends", "field": null },
        "fields": {
          "displayName": { "type": "string", "optional": false },
          "bio": { "type": "string", "optional": true },
          "avatarUrl": { "type": "string", "optional": true }
        }
      }
    },
    {
      "name": "settings: lww + self audience (private)",
      "config": {
        "fields": { "theme": "string", "notificationsEnabled": "boolean" },
        "sync": "lww",
        "audience": { "kind": "self" }
      },
      "expect": {
        "sync": "lww",
        "ttl": null,
        "audience": { "kind": "self", "field": null },
        "fields": {
          "theme": { "type": "string", "optional": false },
          "notificationsEnabled": { "type": "boolean", "optional": false }
        }
      }
    },
    {
      "name": "pix: lww + conversation audience, number and number? fields",
      "config": {
        "fields": {
          "conversationId": "string",
          "recipientUsername": "string",
          "mediaRef": "string",
          "displayDuration": "number",
          "viewedAt": "number?"
        },
        "sync": "lww",
        "audience": { "kind": "conversation", "field": "conversationId" }
      },
      "expect": {
        "sync": "lww",
        "ttl": null,
        "audience": { "kind": "conversation", "field": "conversationId" },
        "fields": {
          "conversationId": { "type": "string", "optional": false },
          "recipientUsername": { "type": "string", "optional": false },
          "mediaRef": { "type": "string", "optional": false },
          "displayDuration": { "type": "number", "optional": false },
          "viewedAt": { "type": "number", "optional": true }
        }
      }
    },
    {
      "name": "sync omitted defaults to gset",
      "config": { "fields": { "x": "string" } },
      "expect": {
        "sync": "gset",
        "ttl": null,
        "audience": { "kind": "friends", "field": null },
        "fields": { "x": { "type": "string", "optional": false } }
      }
    },
    {
      "name": "recipient audience with a timestamp field",
      "config": {
        "fields": { "recipientUsername": "string", "sentAt": "timestamp" },
        "sync": "gset",
        "audience": { "kind": "recipient", "field": "recipientUsername" }
      },
      "expect": {
        "sync": "gset",
        "ttl": null,
        "audience": { "kind": "recipient", "field": "recipientUsername" },
        "fields": {
          "recipientUsername": { "type": "string", "optional": false },
          "sentAt": { "type": "timestamp", "optional": false }
        }
      }
    },
    {
      "name": "INVALID: unknown sync strategy must fail loud",
      "config": { "fields": { "x": "string" }, "sync": "crdt-magic" },
      "expect": { "error": "INVALID_SCHEMA" }
    },
    {
      "name": "INVALID: unknown field type must fail loud",
      "config": { "fields": { "x": "date" }, "sync": "gset" },
      "expect": { "error": "INVALID_SCHEMA" }
    },
    {
      "name": "INVALID: recipient audience without a field must fail loud",
      "config": { "fields": { "x": "string" }, "sync": "gset", "audience": { "kind": "recipient" } },
      "expect": { "error": "INVALID_SCHEMA" }
    },
    {
      "name": "INVALID: conversation audience with a blank field must fail loud",
      "config": { "fields": { "x": "string" }, "sync": "gset", "audience": { "kind": "conversation", "field": "" } },
      "expect": { "error": "INVALID_SCHEMA" }
    },
    {
      "name": "INVALID: unknown audience kind must fail loud",
      "config": { "fields": { "x": "string" }, "sync": "gset", "audience": { "kind": "everyone" } },
      "expect": { "error": "INVALID_SCHEMA" }
    }
  ]
}
